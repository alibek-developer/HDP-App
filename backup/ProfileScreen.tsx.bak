import MCI from '@expo/vector-icons/MaterialCommunityIcons'
import type { BottomTabNavigationProp } from '@react-navigation/bottom-tabs'
import type { CompositeNavigationProp } from '@react-navigation/native'
import { useNavigation } from '@react-navigation/native'
import type { NativeStackNavigationProp } from '@react-navigation/native-stack'
import { LinearGradient } from 'expo-linear-gradient'
import { useMemo, useState } from 'react'
import {
	Image,
	Pressable,
	ScrollView,
	StyleSheet,
	Text,
	TextInput,
	View,
	useWindowDimensions,
} from 'react-native'
import { useSafeAreaInsets } from 'react-native-safe-area-context'
import Svg, { Circle, Defs, Line, Polyline, Stop, LinearGradient as SvgGrad } from 'react-native-svg'
import { navBottomSpace } from '../components/BottomNav'
import Sheet from '../components/Sheet'
import { TopScrim } from '../components/ui'
import {
	ACHIEVEMENTS,
	ALL_SETS,
	WEEK_LABELS,
	currentWeekKeys,
	unlockedAchievements,
	type AchIcon,
	type AchStats,
} from '../data/content'
import { TOPICS, shortTitle } from '../data/curriculum'
import { triggerHaptic } from '../lib/haptics'
import type { RootStackParamList, TabParamList } from '../navigation/types'
import { useApp } from '../store/useStore'
import { ABS_FILL } from '../theme/tokens'

type Nav = CompositeNavigationProp<
	BottomTabNavigationProp<TabParamList>,
	NativeStackNavigationProp<RootStackParamList>
>

// ── HDP rang tizimi ──────────────────────────────────────────────
const G = {
	brand:      '#006C49',
	brandLight: '#10B981',
	brandDark:  '#00422B',
	brandSoft:  '#DCFCE7',
	brandMid:   '#D1FAE5',

	ink:        '#131B2E',
	ink2:       '#3C4A42',
	ink3:       '#6C7A71',
	ink4:       '#A8B5A2',

	surface:    '#FAF8FF',
	card:       '#FFFFFF',
	border:     '#E2E7FF',
	hairline:   '#EEF0EC',

	coin:       '#F59E0B',
	coinSoft:   '#FEF3C7',
	xp:         '#3B82F6',
	xpSoft:     '#DBEAFE',

	danger:     '#BA1A1A',
	dangerSoft: '#FFDAD6',

	amber:      '#D97706',
	amberSoft:  '#FEF3C7',

	violet:     '#7C3AED',
	violetSoft: '#EDE9FE',
}

const MONTHS_UZ = [
	'Yanvar','Fevral','Mart','Aprel','May','Iyun',
	'Iyul','Avgust','Sentabr','Oktabr','Noyabr','Dekabr',
]

const ICONS: Record<AchIcon, keyof typeof MCI.glyphMap> = {
	bolt:    'lightning-bolt',
	trophy:  'trophy-outline',
	grid:    'view-grid-outline',
	cap:     'school-outline',
	books:   'bookshelf',
	check:   'check-circle-outline',
	medal:   'medal-outline',
	star:    'star-outline',
	gem:     'diamond-stone',
	target:  'bullseye-arrow',
	flame:   'fire',
	brain:   'head-lightbulb-outline',
	bag:     'shopping-outline',
	heart:   'heart-outline',
	pen:     'pencil-outline',
	rocket:  'rocket-launch-outline',
	moon:    'moon-waning-crescent',
	compass: 'compass-outline',
	sigma:   'function-variant',
	crown:   'crown-outline',
}

const MEDAL_TINT: Record<AchIcon, { bg: string; ink: string }> = {
	bolt:    { bg: G.brandSoft,  ink: G.brand },
	trophy:  { bg: G.coinSoft,   ink: G.amber },
	grid:    { bg: G.xpSoft,     ink: G.xp },
	cap:     { bg: G.brandSoft,  ink: G.brand },
	books:   { bg: G.xpSoft,     ink: G.xp },
	check:   { bg: G.brandSoft,  ink: G.brand },
	medal:   { bg: G.coinSoft,   ink: G.amber },
	star:    { bg: G.coinSoft,   ink: G.amber },
	gem:     { bg: G.violetSoft, ink: G.violet },
	target:  { bg: G.dangerSoft, ink: G.danger },
	flame:   { bg: G.amberSoft,  ink: G.amber },
	brain:   { bg: G.xpSoft,     ink: G.xp },
	bag:     { bg: G.brandSoft,  ink: G.brand },
	heart:   { bg: G.dangerSoft, ink: G.danger },
	pen:     { bg: G.xpSoft,     ink: G.xp },
	rocket:  { bg: G.coinSoft,   ink: G.amber },
	moon:    { bg: '#EDEFF5',    ink: '#4B5570' },
	compass: { bg: G.brandSoft,  ink: G.brand },
	sigma:   { bg: G.brandSoft,  ink: G.brand },
	crown:   { bg: G.coinSoft,   ink: G.amber },
}

const LOCKED_TINT = { bg: '#F2F5F0', ink: '#B7C2B1' }

const ALL_LESSONS = TOPICS.flatMap(t => t.lessons)

const fmtUz = (iso: string) => {
	const d = new Date(iso)
	return `${d.getDate()}-${MONTHS_UZ[d.getMonth()]}, ${d.getFullYear()}`
}

const num = (n: number) => n.toLocaleString('en-US')

// ── Haftalik grafik ──────────────────────────────────────────────
const CH = 100

const WeekChart = ({
	mins,
	width,
	todayIdx,
}: {
	mins: number[]
	width: number
	todayIdx: number
}) => {
	const max = Math.max(...mins)
	const top = max > 0 ? max : 1
	const xAt = (i: number) => 8 + (i * (width - 16)) / 6
	const yAt = (v: number) => CH - 12 - (v / top) * (CH - 24)
	const pts = mins
		.map((m, i) => `${xAt(i)},${Math.round(yAt(m) * 10) / 10}`)
		.join(' ')

	return (
		<Svg width={width} height={CH}>
			<Defs>
				<SvgGrad id='lineGrad' x1='0' y1='0' x2='1' y2='0'>
					<Stop offset='0' stopColor={G.brandLight} stopOpacity='1' />
					<Stop offset='1' stopColor={G.brand} stopOpacity='1' />
				</SvgGrad>
			</Defs>
			{[0, 0.5, 1].map(k => (
				<Line
					key={k}
					x1={0}
					y1={12 + (CH - 24) * k}
					x2={width}
					y2={12 + (CH - 24) * k}
					stroke={G.hairline}
					strokeWidth={1}
					strokeDasharray='4 3'
				/>
			))}
			<Polyline
				points={pts}
				fill='none'
				stroke='url(#lineGrad)'
				strokeWidth={2.5}
				strokeLinejoin='round'
				strokeLinecap='round'
			/>
			{mins.map((m, i) => (
				<Circle
					key={i}
					cx={xAt(i)}
					cy={yAt(m)}
					r={i === todayIdx ? 5 : 4}
					fill={i === todayIdx ? G.brand : G.brandLight}
					stroke='#FFFFFF'
					strokeWidth={i === todayIdx ? 2 : 1.5}
				/>
			))}
		</Svg>
	)
}

// ── Asosiy komponent ─────────────────────────────────────────────
const ProfileScreen = () => {
	const navigation = useNavigation<Nav>()
	const insets    = useSafeAreaInsets()
	const { width } = useWindowDimensions()

	const [editOpen,     setEditOpen]     = useState(false)
	const [bellOpen,     setBellOpen]     = useState(false)
	const [certOpen,     setCertOpen]     = useState(false)
	const [settingsOpen, setSettingsOpen] = useState(false)
	const [allOpen,      setAllOpen]      = useState(false)
	const [outOpen,      setOutOpen]      = useState(false)
	const [draftName,    setDraftName]    = useState('')
	const [draftUser,    setDraftUser]    = useState('')

	const name           = useApp(s => s.name)
	const username       = useApp(s => s.username)
	const email          = useApp(s => s.email)
	const publicId       = useApp(s => s.publicId)
	const photoUrl       = useApp(s => s.photoUrl)
	const theme          = useApp(s => s.theme)
	const topicLessons   = useApp(s => s.topicLessons)
	const topicTests     = useApp(s => s.topicTests)
	const solvedQuestions= useApp(s => s.solvedQuestions)
	const answeredTotal  = useApp(s => s.answeredTotal)
	const answeredCorrect= useApp(s => s.answeredCorrect)
	const xp             = useApp(s => s.xp)
	const level          = useApp(s => s.level)
	const streak         = useApp(s => s.streak)
	const bestStreak     = useApp(s => s.bestStreak)
	const solvedCount    = useApp(s => s.solvedCount)
	const solvedToday    = useApp(s => s.solvedToday)
	const studyMinutes   = useApp(s => s.studyMinutes)
	const orders         = useApp(s => s.orders)
	const reviews        = useApp(s => s.reviews)
	const favs           = useApp(s => s.favs)
	const coin           = useApp(s => s.coin)
	const isPro          = useApp(s => s.isPro)
	const proExpires     = useApp(s => s.proExpires)
	const setProfile     = useApp(s => s.setProfile)
	const setTheme       = useApp(s => s.setTheme)
	const signOut        = useApp(s => s.signOut)

	// ── Ko'rsatkichlar ──
	const lessonsDone = ALL_LESSONS.filter(l => topicLessons[l.id]?.done).length

	const topic = useMemo(() => {
		const t: Record<string, number> = {}
		for (const set of ALL_SETS) {
			const n = Math.min(
				(solvedQuestions[set.id] ?? []).length,
				set.questions.length,
			)
			if (n > 0) t[set.topic] = (t[set.topic] ?? 0) + n
		}
		return t
	}, [solvedQuestions])

	const accuracy =
		answeredTotal > 0
			? Math.round((answeredCorrect / answeredTotal) * 100)
			: 0
	const best = Math.max(bestStreak, streak)

	const stats: AchStats = {
		lessonsDone,
		totalLessons: ALL_LESSONS.length,
		solved:       solvedCount,
		streak,
		bestStreak:   best,
		level,
		accuracy,
		solvedToday,
		orders:       orders.length,
		reviews:      reviews.length,
		favs:         favs.length,
		topic,
	}
	const unlocked    = unlockedAchievements(stats)
	const unlockedIds = new Set(unlocked.map(a => a.id))
	const badges = [
		...unlocked,
		...ACHIEVEMENTS.filter(a => !unlockedIds.has(a.id)),
	].slice(0, 4)

	const marbles = TOPICS.slice(0, 4).map(t => ({
		num:  t.meta.num,
		test: topicTests[t.meta.num],
	}))

	const totalStudyMin = Object.values(studyMinutes).reduce((a, b) => a + b, 0)
	const week          = currentWeekKeys()
	const mins          = week.map(k => studyMinutes[k] ?? 0)
	const totalMin      = mins.reduce((a, b) => a + b, 0)
	const todayIdx      = (new Date().getDay() + 6) % 7
	const peak          = Math.max(...mins)

	const [now] = useState(() => Date.now())
	const proDays = proExpires
		? Math.ceil((Date.parse(proExpires + 'T00:00:00') - now) / 86_400_000)
		: 0
	const planLabel =
		proDays >= 300 ? 'Yillik obuna' : proDays >= 25 ? 'Oylik obuna' : 'Sinov muddati'
	const proActive = isPro && proDays > 0

	const initials = name
		.split(' ')
		.filter(Boolean)
		.map(w => w[0])
		.join('')
		.slice(0, 2)
		.toUpperCase()

	const identity = [username ? `@${username}` : email, publicId]
		.filter(Boolean)
		.join(' · ')

	const chartW = Math.max(180, width - 96)

	const openEdit = () => {
		setDraftName(name)
		setDraftUser(username)
		setEditOpen(true)
	}

	const saveProfile = () => {
		const nm = draftName.trim()
		if (!nm) return
		triggerHaptic('success')
		setProfile(nm, draftUser.trim().replace(/^@/, ''))
		setEditOpen(false)
	}

	// XP daraja
	const XP_LEVELS = [0, 500, 1500, 3500, 7000, 12000, 20000]
	const lvlIdx    = Math.min(level - 1, XP_LEVELS.length - 2)
	const xpStart   = XP_LEVELS[lvlIdx] ?? 0
	const xpEnd     = XP_LEVELS[lvlIdx + 1] ?? 20000
	const xpPct     = Math.min(100, Math.round(((xp - xpStart) / (xpEnd - xpStart)) * 100))

	return (
		<View style={p.screen}>
			<ScrollView
				showsVerticalScrollIndicator={false}
				contentContainerStyle={[
					p.scroll,
					{
						paddingTop:    insets.top + 10,
						paddingBottom: navBottomSpace(insets.bottom),
					},
				]}
			>
				{/* ── 1. Header ── */}
				<View style={p.head}>
					<Text style={p.h1}>Profil</Text>
					<View style={p.headBtns}>
						<HeadBtn
							icon='crown-outline'
							label='HDP Pro'
							tint={G.violetSoft}
							ink={G.violet}
							onPress={() => { triggerHaptic('light'); navigation.navigate('Pro') }}
						/>
						<HeadBtn
							icon='bell-outline'
							label='Faollik hisoboti'
							tint={G.brandSoft}
							ink={G.brand}
							onPress={() => { triggerHaptic('light'); setBellOpen(true) }}
						/>
						<HeadBtn
							icon='cog-outline'
							label='Sozlamalar'
							tint={G.surface}
							ink={G.ink2}
							onPress={() => { triggerHaptic('light'); setSettingsOpen(true) }}
						/>
					</View>
				</View>

				{/* ── 2. Avatar va ism ── */}
				<Pressable
					onPress={() => { triggerHaptic('light'); openEdit() }}
					accessibilityLabel='Profilni tahrirlash'
					style={({ pressed }) => [p.avatarWrap, pressed && { opacity: 0.85 }]}
				>
					<View style={p.avatarRing}>
						<View style={p.avatarInner}>
							{photoUrl ? (
								<Image source={{ uri: photoUrl }} style={p.avatarImg} />
							) : (
								<LinearGradient
									colors={[G.brandLight, G.brand]}
									start={{ x: 0, y: 0 }}
									end={{ x: 1, y: 1 }}
									style={[ABS_FILL, { alignItems: 'center', justifyContent: 'center' }]}
								>
									{initials ? (
										<Text style={p.avatarText}>{initials}</Text>
									) : (
										<MCI name='account-outline' size={32} color='rgba(255,255,255,0.9)' />
									)}
								</LinearGradient>
							)}
						</View>
					</View>
				</Pressable>

				<Pressable
					onPress={() => { triggerHaptic('light'); openEdit() }}
					accessibilityLabel='Profilni tahrirlash'
					style={({ pressed }) => [p.nameRow, pressed && { opacity: 0.6 }]}
				>
					<Text numberOfLines={1} style={p.name}>
						{name || 'Ismingizni kiriting'}
					</Text>
					<MCI name='pencil-outline' size={15} color={G.ink3} />
				</Pressable>

				{identity ? (
					<Text numberOfLines={1} style={p.identity}>{identity}</Text>
				) : null}

				{/* ── 3. XP daraja chizig'i ── */}
				<View style={p.levelWrap}>
					<View style={p.levelRow}>
						<View style={p.levelBadge}>
							<Text style={p.levelBadgeText}>Lv.{level}</Text>
						</View>
						<View style={p.levelBarBg}>
							<View style={[p.levelBarFill, { width: `${xpPct}%` }]} />
						</View>
						<Text style={p.levelXp}>{num(xp)} XP</Text>
					</View>
				</View>

				{/* ── 4. Pro banner ── */}
				<Pressable
					onPress={() => {
						triggerHaptic(proActive ? 'light' : 'medium')
						navigation.navigate('Pro')
					}}
					style={({ pressed }) => [p.proWrap, pressed && { opacity: 0.92 }]}
				>
					<LinearGradient
						colors={proActive
							? [G.brand, G.brandDark]
							: ['#1a1a2e', '#16213e']}
						start={{ x: 0, y: 0 }}
						end={{ x: 1, y: 1 }}
						style={p.proBanner}
					>
						<View style={p.proIconWrap}>
							<MCI
								name={proActive ? 'shield-check-outline' : 'crown-outline'}
								size={20}
								color='#FFFFFF'
							/>
						</View>
						<View style={p.proMid}>
							<Text numberOfLines={1} style={p.proTitle}>
								{proActive ? 'HDP Pro faol' : "Pro bilan ko'proq o'rganish"}
							</Text>
							<Text numberOfLines={1} style={p.proSub}>
								{proActive
									? `${planLabel}${proExpires ? ` · ${fmtUz(proExpires)}` : ''}`
									: 'Barcha mavzular va testlar ochiq'}
							</Text>
						</View>
						<MCI name='chevron-right' size={18} color='rgba(255,255,255,0.6)' />
					</LinearGradient>
				</Pressable>

				{/* ── 5. Asosiy statistika ── */}
				<View style={p.statsGrid}>
					<StatTile icon='lightning-bolt'  tint={G.coinSoft}   ink={G.coin}   value={num(coin)}        label='Coin' />
					<StatTile icon='star-four-points' tint={G.xpSoft}    ink={G.xp}    value={num(xp)}          label='XP' />
					<StatTile icon='check-all'        tint={G.brandSoft} ink={G.brand} value={`${solvedCount}`} label='Masalalar' />
					<StatTile icon='percent'          tint={G.amberSoft} ink={G.amber} value={`${accuracy}%`}   label='Aniqlik' />
				</View>

				{/* ── 6. Ko'rsatkichlar ── */}
				<View style={p.card}>
					<SectionHead title="Ko'rsatkichlar" />
					<View style={p.metricsWrap}>
						<MetricRow
							icon='clock-time-four-outline'
							tint={G.xpSoft}
							ink={G.xp}
							value={`${totalStudyMin} daq`}
							label="O'qish vaqti"
						/>
						<Divider />
						<MetricRow
							icon='book-open-page-variant'
							tint={G.brandSoft}
							ink={G.brand}
							value={`${lessonsDone} ta`}
							label='Tugatilgan darslar'
						/>
						<Divider />
						<MetricRow
							icon='fire'
							tint={G.amberSoft}
							ink={G.amber}
							value={`${streak} kun`}
							label='Joriy seriya'
						/>
						<Divider />
						<MetricRow
							icon='trophy-variant-outline'
							tint={G.violetSoft}
							ink={G.violet}
							value={`${best} kun`}
							label='Rekord seriya'
						/>
					</View>
				</View>

				{/* ── 7. Haftalik faollik ── */}
				<View style={p.card}>
					<View style={p.secHead}>
						<View style={p.secLeft}>
							<Text style={p.cardTitle}>Haftalik faollik</Text>
							<Text style={p.cardSub}>Hafta davomidagi o&apos;qish vaqti (daq)</Text>
						</View>
						<MCI name='chart-line-variant' size={20} color={G.brand} />
					</View>

					<View style={p.chartRow}>
						<View style={p.yAxis}>
							<Text style={p.yLabel}>{peak > 0 ? `${peak}` : '0'}</Text>
							<Text style={p.yLabel}>
								{peak > 0 ? `${Math.round(peak / 2)}` : ''}
							</Text>
							<Text style={p.yLabel}>0</Text>
						</View>
						<WeekChart mins={mins} width={chartW} todayIdx={todayIdx} />
					</View>

					<View style={p.xAxis}>
						{WEEK_LABELS.map((l, i) => (
							<Text
								key={l}
								style={[p.xLabel, i === todayIdx && p.xLabelToday]}
							>
								{l}
							</Text>
						))}
					</View>

					<View style={p.chartLegend}>
						<View style={p.legendDot} />
						<Text numberOfLines={1} style={p.legendName}>
							{name || 'Siz'}
						</Text>
						<Text style={p.legendValue}>{totalMin} daqiqa</Text>
					</View>
				</View>

				{/* ── 8. Nishonlar ── */}
				<View style={p.card}>
					<SectionHead
						title='Nishonlar'
						action='Barchasi'
						onAction={() => { triggerHaptic('light'); setAllOpen(true) }}
					/>
					<View style={p.badgeRow}>
						{badges.map(m => {
							const on   = unlockedIds.has(m.id)
							const tint = on ? MEDAL_TINT[m.icon] : LOCKED_TINT
							return (
								<View key={m.id} style={p.badgeCol}>
									<View
										style={[
											p.badgeCircle,
											{
												backgroundColor: tint.bg,
												opacity:         on ? 1 : 0.55,
												borderWidth:     on ? 0 : 1.5,
												borderColor:     '#DDE3DA',
											},
										]}
									>
										<MCI name={ICONS[m.icon]} size={22} color={tint.ink} />
									</View>
									<Text numberOfLines={2} style={p.badgeTitle}>
										{m.title}
									</Text>
								</View>
							)
						})}
					</View>
				</View>

				{/* ── 9. Marralar ── */}
				<View style={p.card}>
					<SectionHead
						title='Marralar'
						action='Barchasi'
						onAction={() => { triggerHaptic('light'); setCertOpen(true) }}
					/>
					<View style={p.badgeRow}>
						{marbles.map(({ num: n, test }) => {
							const on = !!test
							return (
								<View key={n} style={p.badgeCol}>
									<View
										style={[
											p.marbleCircle,
											{
												backgroundColor: on ? G.brandSoft : '#F2F5F0',
												borderColor:     on ? G.brand : '#DDE3DA',
											},
										]}
									>
										{test ? (
											<Text style={p.marbleScore}>
												{test.score}/{test.total}
											</Text>
										) : (
											<MCI name='lock-outline' size={15} color='#B7C2B1' />
										)}
									</View>
									<Text style={[p.badgeTitle, { color: on ? G.ink2 : G.ink3 }]}>
										{n}-mavzu
									</Text>
								</View>
							)
						})}
					</View>
				</View>

				{/* ── 10. Footer ── */}
				<View style={p.footer}>
					<Text style={p.footerApp}>HDP Academy 1.0.0</Text>
					<Text style={p.footerSub}>Matematika o&apos;quv platformasi</Text>
				</View>
			</ScrollView>

			<TopScrim
				height={insets.top}
				colors={['#FFFFFF', '#FFFFFF']}
				line='rgba(14,26,18,0.06)'
			/>

			{/* ── Sheet: tahrirlash ── */}
			<Sheet open={editOpen} onClose={() => setEditOpen(false)} title='Profilni tahrirlash'>
				<Field
					label='Ism familiya'
					value={draftName}
					onChange={setDraftName}
					placeholder='Ismingiz'
				/>
				<Field
					label='Telegram foydalanuvchi nomi'
					value={draftUser}
					onChange={setDraftUser}
					placeholder='username'
					prefix='@'
				/>
				<Pressable
					onPress={saveProfile}
					disabled={!draftName.trim()}
					style={({ pressed }) => [
						p.btnPrimary,
						!draftName.trim() ? { opacity: 0.4 } : pressed ? { opacity: 0.85 } : null,
					]}
				>
					<Text style={p.btnPrimaryText}>Saqlash</Text>
				</Pressable>
			</Sheet>

			{/* ── Sheet: faollik hisoboti ── */}
			<Sheet
				open={bellOpen}
				onClose={() => setBellOpen(false)}
				title='Faollik hisoboti'
				subtitle="Bugungi faollik va hisob ma'lumotlari."
			>
				<Note label='Bugungi faollik'
					value={solvedToday > 0
						? `${solvedToday} ta masala yechildi`
						: 'Hali birorta masala yechilmadi'}
				/>
				<Note
					label='Aniqlik'
					value={answeredTotal > 0
						? `${accuracy}% · ${answeredCorrect}/${answeredTotal}`
						: 'Hali javob berilmagan'}
				/>
				<Note label='Seriya'    value={`${streak} kun · rekord ${bestStreak} kun`} />
				<Note label='Pro muddati'
					value={proActive && proExpires ? fmtUz(proExpires) : 'Pro yoqilmagan'}
				/>
				<Note
					label='Buyurtmalar'
					value={orders.length > 0
						? `${orders.length} ta sovg'a buyurtma qilingan`
						: "Hali buyurtma yo'q"}
				/>
				<Pressable
					onPress={() => { triggerHaptic('selection'); setBellOpen(false); navigation.navigate('Problems') }}
					style={({ pressed }) => [p.btnPrimary, pressed && { opacity: 0.9 }]}
				>
					<Text style={p.btnPrimaryText}>Kunlik masalaga o&apos;tish</Text>
				</Pressable>
			</Sheet>

			{/* ── Sheet: natijalar ── */}
			<Sheet
				open={certOpen}
				onClose={() => setCertOpen(false)}
				title='Natijalar'
				subtitle='Har bir mavzu yakuniy testining natijasi.'
			>
				{TOPICS.every(t => !topicTests[t.meta.num]) ? (
					<Text style={p.sheetText}>
						Hozircha natija yo&apos;q. Har mavzu oxiridagi yakuniy testni
						tugating — natija shu yerda paydo bo&apos;ladi.
					</Text>
				) : (
					TOPICS.filter(t => topicTests[t.meta.num]).map(t => {
						const test = topicTests[t.meta.num]
						return (
							<View key={t.meta.num} style={p.certRow}>
								<View style={p.certIcon}>
									<MCI name='school-outline' size={16} color={G.brand} />
								</View>
								<View style={p.certMid}>
									<Text numberOfLines={1} style={p.certTitle}>
										Mavzu {t.meta.num} · {shortTitle(t.meta.title)}
									</Text>
									<Text style={p.certScore}>
										{test.score}/{test.total} to&apos;g&apos;ri
									</Text>
								</View>
								<MCI name='check-circle-outline' size={19} color={G.brand} />
							</View>
						)
					})
				)}
				<Text style={p.sheetFoot}>
					Natijalar shu qurilmadagi profilingizda saqlanadi.
				</Text>
			</Sheet>

			{/* ── Sheet: sozlamalar ── */}
			<Sheet open={settingsOpen} onClose={() => setSettingsOpen(false)} title='Sozlamalar'>
				<Text style={p.sheetText}>Ko&apos;rinish va ilova qoidalari.</Text>
				<View style={p.themeList}>
					{[
						{ key: 'light' as const, label: "Yorug' rejim",    icon: 'weather-sunny'      as const, ready: true },
						{ key: 'dark'  as const, label: "Qorong'u rejim",  icon: 'moon-waning-crescent' as const, ready: false },
					].map(o => {
						const active = theme === o.key
						return (
							<Pressable
								key={o.key}
								disabled={!o.ready}
								onPress={() => { triggerHaptic('selection'); setTheme(o.key) }}
								style={({ pressed }) => [
									p.themeRow,
									!o.ready && { opacity: 0.45 },
									pressed && o.ready && { backgroundColor: G.brandSoft },
								]}
							>
								<View style={[p.themeIconBox, { backgroundColor: active ? G.brandSoft : G.surface }]}>
									<MCI name={o.icon} size={16} color={active ? G.brand : G.ink3} />
								</View>
								<Text style={[p.themeLabel, active && { color: G.brand }]}>{o.label}</Text>
								{!o.ready && <Pill label='Tez orada' bg={G.surface} ink={G.ink3} />}
								{o.ready && (
									<MCI
										name={active ? 'radiobox-marked' : 'radiobox-blank'}
										size={18}
										color={active ? G.brand : '#C9D3C4'}
									/>
								)}
							</Pressable>
						)
					})}
				</View>
				<View style={p.helpList}>
					{[
						['Kunlik masala',   'Har kuni yangilanadi va coin beradi'],
						['Natijalar',       'Shu qurilmada saqlanadi'],
						["Do'kon buyurtma", 'Profilingizda saqlanadi'],
					].map(([k, v]) => (
						<View key={k} style={p.helpRow}>
							<Text style={p.helpKey}>{k}</Text>
							<Text style={p.helpValue}>{v}</Text>
						</View>
					))}
				</View>
				<Pressable
					onPress={() => { triggerHaptic('warning'); setSettingsOpen(false); setOutOpen(true) }}
					style={({ pressed }) => [p.btnDanger, pressed && { opacity: 0.9 }]}
				>
					<Text style={p.btnDangerText}>Chiqish</Text>
				</Pressable>
			</Sheet>

			{/* ── Sheet: barcha nishonlar ── */}
			<Sheet
				open={allOpen}
				onClose={() => setAllOpen(false)}
				title='Barcha nishonlar'
				subtitle={`${unlocked.length} / ${ACHIEVEMENTS.length} ochilgan`}
			>
				<View style={p.medalGrid}>
					{ACHIEVEMENTS.map(a => {
						const on   = unlockedIds.has(a.id)
						const tint = on ? MEDAL_TINT[a.icon] : LOCKED_TINT
						return (
							<View key={a.id} style={[p.medalCell, { opacity: on ? 1 : 0.5 }]}>
								<View style={[p.medalCellIcon, { backgroundColor: tint.bg }]}>
									<MCI name={ICONS[a.icon]} size={16} color={tint.ink} />
								</View>
								<View style={p.medalCellMid}>
									<Text numberOfLines={1} style={p.medalCellTitle}>{a.title}</Text>
									<Text numberOfLines={1} style={p.medalCellHint}>{a.hint}</Text>
								</View>
							</View>
						)
					})}
				</View>
			</Sheet>

			{/* ── Sheet: chiqish ── */}
			<Sheet open={outOpen} onClose={() => setOutOpen(false)} title='Chiqish'>
				<Text style={p.sheetText}>
					Sessiya yopiladi va boshlang&apos;ich ekranga qaytasiz. Progress —
					darslar, coin, seriya va buyurtmalar — o&apos;rnida qoladi.
				</Text>
				<Pressable
					onPress={() => {
						triggerHaptic('warning')
						setOutOpen(false)
						signOut()
						navigation.replace('Onboarding')
					}}
					style={({ pressed }) => [p.btnDanger, pressed && { opacity: 0.9 }]}
				>
					<Text style={p.btnDangerText}>Ha, chiqaman</Text>
				</Pressable>
				<Pressable
					onPress={() => { triggerHaptic('light'); setOutOpen(false) }}
					style={({ pressed }) => [p.btnGhost, pressed && { opacity: 0.8 }]}
				>
					<Text style={p.btnGhostText}>Bekor qilish</Text>
				</Pressable>
			</Sheet>
		</View>
	)
}

// ── Kichik komponentlar ──────────────────────────────────────────

const HeadBtn = ({
	icon, label, tint, ink, onPress,
}: {
	icon: keyof typeof MCI.glyphMap
	label: string
	tint: string
	ink: string
	onPress: () => void
}) => (
	<Pressable
		onPress={onPress}
		hitSlop={8}
		accessibilityLabel={label}
		style={({ pressed }) => [
			s.headBtn,
			{ backgroundColor: tint },
			pressed && { opacity: 0.65 },
		]}
	>
		<MCI name={icon} size={17} color={ink} />
	</Pressable>
)

const StatTile = ({
	icon, tint, ink, value, label,
}: {
	icon: keyof typeof MCI.glyphMap
	tint: string
	ink: string
	value: string
	label: string
}) => (
	<View style={[s.statTile, { borderTopColor: ink, borderTopWidth: 2.5 }]}>
		<View style={[s.statIconBox, { backgroundColor: tint }]}>
			<MCI name={icon} size={14} color={ink} />
		</View>
		<Text style={s.statValue}>{value}</Text>
		<Text style={s.statLabel}>{label}</Text>
	</View>
)

const MetricRow = ({
	icon, tint, ink, value, label,
}: {
	icon: keyof typeof MCI.glyphMap
	tint: string
	ink: string
	value: string
	label: string
}) => (
	<View style={s.metricRow}>
		<View style={[s.metricIcon, { backgroundColor: tint }]}>
			<MCI name={icon} size={16} color={ink} />
		</View>
		<Text numberOfLines={1} style={s.metricLabel}>{label}</Text>
		<Text numberOfLines={1} style={[s.metricValue, { color: ink }]}>{value}</Text>
	</View>
)

const SectionHead = ({
	title, action, onAction,
}: {
	title: string
	action?: string
	onAction?: () => void
}) => (
	<View style={s.secHead}>
		<Text style={s.cardTitle}>{title}</Text>
		{action && onAction && (
			<Pressable
				onPress={onAction}
				hitSlop={12}
				style={({ pressed }) => [s.secActionBtn, pressed && { opacity: 0.6 }]}
			>
				<Text style={s.secAction}>{action}</Text>
				<MCI name='chevron-right' size={13} color={G.brand} />
			</Pressable>
		)}
	</View>
)

const Divider = () => <View style={s.divider} />

const Pill = ({ label, bg, ink }: { label: string; bg: string; ink: string }) => (
	<View style={[s.pill, { backgroundColor: bg }]}>
		<Text style={[s.pillText, { color: ink }]}>{label}</Text>
	</View>
)

const Note = ({ label, value }: { label: string; value: string }) => (
	<View style={s.noteRow}>
		<Text style={s.noteLabel}>{label}</Text>
		<Text style={s.noteValue}>{value}</Text>
	</View>
)

const Field = ({
	label, value, onChange, placeholder, prefix,
}: {
	label: string
	value: string
	onChange: (v: string) => void
	placeholder: string
	prefix?: string
}) => (
	<View style={s.fieldWrap}>
		<Text style={s.fieldLabel}>{label}</Text>
		<View style={s.fieldBox}>
			{!!prefix && <Text style={s.fieldPrefix}>{prefix}</Text>}
			<TextInput
				value={value}
				onChangeText={onChange}
				placeholder={placeholder}
				placeholderTextColor={G.ink4}
				style={s.fieldInput}
			/>
		</View>
	</View>
)

