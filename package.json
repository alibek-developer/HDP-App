{
  "name": "hdp-math-bot",
  "version": "1.0.0",
  "type": "module",
  "description": "HDP Math Telegram WebApp",
  "scripts": {
    "dev:webapp": "cd webapp && vite",
    "dev:bot": "cd bot && ts-node index.ts",
    "build": "cd webapp && vite build",
    "build:vercel": "cd webapp && vite build",
    "build:bot": "tsc -p bot/tsconfig.json",
    "start": "node bot/dist/index.js",
    "preview": "cd webapp && vite preview",
    "app:icons": "node scripts/make-icon.mjs && capacitor-assets generate --android",
    "app:sync": "npm run build && cap sync android",
    "app:apk": "npm run app:sync && cd android && gradlew.bat assembleDebug"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "dotenv": "^18.0.9",
    "framer-motion": "^10.16.0",
    "grammy": "^1.46.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.0",
    "vite": "^5.0.0"
  }
}
